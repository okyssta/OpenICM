# PostgreSQL connection string used by Prisma and the app.
# For Docker Compose this default matches the `db` service.
DATABASE_URL="postgresql://openicm:openicm@localhost:5432/openicm?schema=public"

# The organization ID all requests run under (single-tenant MVP).
# A default org is created by the seed script.
ORG_ID=""

# Authentication (optional — leave empty for open access / dev mode)
APP_PASSWORD="change-me"
AUTH_SECRET="generate-a-random-secret-here"

# API key for programmatic access (optional)
API_KEY=""
